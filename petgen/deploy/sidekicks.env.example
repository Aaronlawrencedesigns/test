# Desktop Sidekicks worker settings. Edit with:  sudo nano /etc/sidekicks.env
# then restart:  sudo systemctl restart sidekicks-worker
GPTPROTO_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POSTMARK_TOKEN=
OWNER_EMAIL=
# 1 = also make Stripe test-mode orders (each costs ~$9 in AI generation)
ALLOW_TEST_ORDERS=0
S3_ENDPOINT=https://a58202f886867f02d5c696a9976797ba.r2.cloudflarestorage.com
S3_BUCKET=desktopsidekicks-orders
AWS_DEFAULT_REGION=auto
SIDEKICKS_WORK=/var/lib/sidekicks/orders
